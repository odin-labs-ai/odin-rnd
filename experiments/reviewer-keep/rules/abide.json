    {
      "ruleId": "abide/clearer-code-over-comment",
      "sourcePath": ".abide/rubric.json",
      "line": 626,
      "kind": "rubric",
      "text": "If code needs a comment to be understood, first make the code clearer (rename, extract). Comment only what better code can't express.",
      "flags": null,
      "context": "Checked after each file edit, on that edit's diff, given the user's latest request.",
      "maxClass": null,
      "inputKind": "diff",
      "stratum": "primary",
      "withheld": {
        "check": {
          "type": "model",
          "question": {
            "type": "boolean",
            "instructions": "Does this change add a comment that explains a vague name or a dense expression, where renaming the identifier or extracting a named function would have said the same thing?",
            "criteria": {
              "true": "// d is the number of days since the last run\\nconst d = ...",
              "false": "// Node resolves this symlink differently on Windows"
            }
          }
        },
        "status": "active",
        "calibration": {
          "at": "2026-09-20T07:58:13.854Z",
          "hunks": 20,
          "median": 0.125,
          "min": 0.01,
          "max": 0.3,
          "fired": 0,
          "verdict": "decisive"
        },
        "when": "edit",
        "upstreamSource": {
          "path": "AGENTS.md",
          "line": 87
        }
      }
    },
    {
      "ruleId": "abide/derive-one-status-type",
      "sourcePath": ".abide/rubric.json",
      "line": 696,
      "kind": "rubric",
      "text": "When behavior depends on several related status checks, derive one closed decision/status type and switch over that — don't scatter conditionals through a method.",
      "flags": null,
      "context": "Checked after each file edit, on that edit's diff, given the user's latest request. Applies only to files matching: **/*.ts, **/*.tsx.",
      "maxClass": null,
      "inputKind": "diff",
      "stratum": "primary",
      "withheld": {
        "scope": [
          "**/*.ts",
          "**/*.tsx"
        ],
        "check": {
          "type": "model",
          "question": {
            "type": "boolean",
            "instructions": "Does this change decide one outcome from several related boolean or status checks spread through a function, instead of deriving one closed status value and switching over it?",
            "criteria": {
              "true": "if (isWeak) ... later if (isNoisy) ... later if (!isWeak && !isNoisy) ...",
              "false": "const verdict = toVerdict(stats); switch (verdict) { ... }"
            }
          }
        },
        "status": "active",
        "calibration": {
          "at": "2026-09-20T07:58:13.854Z",
          "hunks": 15,
          "median": 0.12,
          "min": 0.05,
          "max": 0.88,
          "fired": 1,
          "verdict": "decisive"
        },
        "when": "edit",
        "upstreamSource": {
          "path": "AGENTS.md",
          "line": 95
        }
      }
    },
