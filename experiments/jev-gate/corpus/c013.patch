+import { loadSettings } from '../config/settings';
+import { createPool } from '../infra/db/pool';
+
+export async function purgeCancelledOrders(): Promise<number> {
+  const pool = createPool(loadSettings().databaseUrl);
+  try {
+    const result = await pool.query("delete from orders where body->>'status' = 'cancelled'");
+    return result.rowCount ?? 0;
+  } finally {
+    await pool.end();
+  }
+}
