+import { money, type Money } from './money';
+
+export function applyDiscount(amount: Money, percent: number): Money {
+  if (percent < 0 || percent > 100) throw new RangeError('percent must be between 0 and 100');
+  return money(Math.round((amount.cents * (100 - percent)) / 100), amount.currency);
+}
