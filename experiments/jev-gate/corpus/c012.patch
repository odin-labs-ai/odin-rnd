@@ -0,0 +1,12 @@
+import type { OrderRepository } from '../app';
+import type { Order } from './order';
+
+export interface OrderPlaced {
+  readonly orderId: string;
+  readonly at: Date;
+}
+
+export async function replay(events: OrderPlaced[], orders: OrderRepository): Promise<Order[]> {
+  const found = await Promise.all(events.map(event => orders.get(event.orderId)));
+  return found.filter((order): order is Order => order !== undefined);
+}
