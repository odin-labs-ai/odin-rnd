 }
+
+export async function invoiceExists(databaseUrl: string, number: string): Promise<boolean> {
+  const { default: pg } = await import('pg');
+  const client = new pg.Client({ connectionString: databaseUrl });
+  await client.connect();
+  try {
+    const result = await client.query('select 1 from invoices where number = $1', [number]);
+    return result.rowCount !== 0;
+  } finally {
+    await client.end();
+  }
+}
