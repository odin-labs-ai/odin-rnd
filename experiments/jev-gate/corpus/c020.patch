@@ -0,0 +1,8 @@
+import { cancelOrder, DomainError } from '../domain';
+import type { OrderRepository } from './ports';
+
+export async function cancelOrderUseCase(orders: OrderRepository, orderId: string): Promise<void> {
+  const order = await orders.get(orderId);
+  if (!order) throw new DomainError('order.missing', `order ${orderId} not found`);
+  await orders.save(cancelOrder(order));
+}
