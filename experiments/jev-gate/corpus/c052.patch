+import type { Invoice } from '../domain';
+
+export async function invoicesCsv(invoices: readonly Invoice[]): Promise<string> {
+  const { toCsv } = await import('../infra/files/csv');
+  return toCsv([
+    ['number', 'order', 'amount'],
+    ...invoices.map(invoice => [invoice.number, invoice.orderId, (invoice.amount.cents / 100).toFixed(2)]),
+  ]);
+}
diff --git a/src/infra/files/csv.ts b/src/infra/files/csv.ts
new file mode 100644
index 0000000..4d75831
