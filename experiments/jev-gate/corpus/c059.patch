+export type LogLevel = 'debug' | 'info' | 'warn';
+
+export function logLevel(): LogLevel {
+  const level = process.env.LOG_LEVEL ?? 'info';
+  return level === 'debug' || level === 'warn' ? level : 'info';
+}
