+import { createPool } from '../infra/db/pool';
+
+export async function databaseReachable(databaseUrl: string): Promise<boolean> {
+  const pool = createPool(databaseUrl);
+  try {
+    await pool.query('select 1');
+    return true;
+  } catch {
+    return false;
+  } finally {
+    await pool.end();
+  }
+}
