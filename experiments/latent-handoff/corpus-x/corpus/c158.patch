@@ -0,0 +1,5 @@
+export function withEnv<T>(vars: Record<string, string>, run: () => T): T {
+  const saved = { ...process.env };
+  Object.assign(process.env, vars);
+  try { return run(); } finally { process.env = saved; }
+}
