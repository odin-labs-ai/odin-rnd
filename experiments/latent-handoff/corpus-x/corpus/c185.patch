+import { type Money, money } from './money';
+
+export function vatOn(amount: Money, ratePercent: number): Money {
+  if (ratePercent < 0) throw new RangeError('a tax rate cannot be negative');
+  return money(Math.round((amount.cents * ratePercent) / 100), amount.currency);
+}
