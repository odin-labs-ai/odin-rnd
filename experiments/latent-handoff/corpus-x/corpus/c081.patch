+import type pg from 'pg';
+
+export async function ensureSchema(pool: pg.Pool): Promise<void> {
+  await pool.query('create table if not exists orders (id text primary key, body jsonb not null)');
+  await pool.query('create table if not exists customers (id text primary key, body jsonb not null)');
+  await pool.query('create table if not exists invoices (number text primary key, body jsonb not null)');
+  await pool.query('create sequence if not exists invoice_seq');
+}
