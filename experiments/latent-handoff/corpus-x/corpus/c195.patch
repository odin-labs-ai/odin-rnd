+// Plain JavaScript seed data for local runs.
+import { createPool as poolFor } from '../infra/db/pool';
+
+export async function seedRates(url) {
+  const db = poolFor(url);
+  await db.query("insert into rates (code, percent) values ('std', 21) on conflict do nothing");
+  await db.end();
+}
