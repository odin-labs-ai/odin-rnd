+import { loadSettings as readSettings } from '../config/settings';
+import { createPool as openPool } from '../infra/db/pool';
+
+export async function overdueInvoiceNumbers(today: Date): Promise<string[]> {
+  const db = openPool(readSettings().databaseUrl);
+  const rows = await db.query("select number from invoices where (body->>'dueAt')::date < $1", [today.toISOString().slice(0, 10)]);
+  await db.end();
+  return rows.rows.map(row => String(row.number));
+}
