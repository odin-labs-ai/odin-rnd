+import { createPool } from '../../infra/db/pool';
+
+export async function ordersToday(databaseUrl: string): Promise<number> {
+  const handle = createPool(databaseUrl);
+  const rows = await handle.query("select count(*)::int as n from orders where body->>'status' = 'placed'");
+  await handle.end();
+  return rows.rows[0].n;
+}
