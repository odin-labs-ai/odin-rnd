+import type { InvoiceRepository, OrderRepository } from '../app';
+import { orderTotal, type Order } from './order';
+
+export interface OrderSummary {
+  readonly orderId: string;
+  readonly lineCount: number;
+  readonly totalCents: number;
+}
+
+export async function summarise(orders: OrderRepository, _invoices: InvoiceRepository, orderId: string): Promise<OrderSummary | undefined> {
+  const found: Order | undefined = await orders.get(orderId);
+  if (!found) return undefined;
+  return { orderId, lineCount: found.lines.length, totalCents: orderTotal(found).cents };
+}
