+import * as settingsModule from '../config/settings';
+import type { Customer, Invoice } from '../domain';
+import { SmtpNotifier } from '../infra/mail/mailer';
+
+export async function remind(pairs: ReadonlyArray<[Customer, Invoice]>): Promise<number> {
+  const settings = settingsModule.loadSettings();
+  const mail = new SmtpNotifier(settings.smtpHost, settings.smtpFrom);
+  for (const [customer, invoice] of pairs) await mail.invoiceIssued(customer, invoice);
+  return pairs.length;
+}
