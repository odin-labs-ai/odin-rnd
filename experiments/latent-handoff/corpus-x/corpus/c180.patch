+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { add, money } from '../src/domain';
+
+test('adding two amounts keeps the currency', () => {
+  assert.deepEqual(add(money(150), money(250)), { cents: 400, currency: 'EUR' });
+});
+
+test('mixed currencies are refused', () => {
+  assert.throws(() => add(money(1, 'EUR'), money(1, 'USD')), RangeError);
+});
