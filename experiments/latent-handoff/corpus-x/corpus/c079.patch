+export async function resetInvoiceSequence(connectionString: string): Promise<void> {
+  const { createPool } = await import('../../infra/db/pool');
+  const db = createPool(connectionString);
+  await db.query('alter sequence invoice_seq restart with 1');
+  await db.end();
+}
