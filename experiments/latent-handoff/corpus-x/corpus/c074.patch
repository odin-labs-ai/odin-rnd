+import type { Services } from '../infra';
 import { DomainError } from './errors';
 import { add, money, multiply, type Money } from './money';
 
@@ -23,3 +24,8 @@ export function placeOrder(order: Order): Order {
   if (order.status !== 'open') throw new DomainError('order.status', 'only open orders can be placed');
   return { ...order, status: 'placed' };
 }
+
+export async function reopen(services: Pick<Services, 'orders'>, orderId: string): Promise<void> {
+  const current = await services.orders.get(orderId);
+  if (current && current.status === 'cancelled') await services.orders.save({ ...current, status: 'open' });
+}
