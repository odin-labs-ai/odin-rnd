+import pg from 'pg';
+
+export async function onInvoiceIssued(connectionString: string, handler: (payload: string) => void): Promise<pg.Client> {
+  const listener = new pg.Client({ connectionString });
+  await listener.connect();
+  listener.on('notification', message => handler(message.payload ?? ''));
+  await listener.query('listen invoice_issued');
+  return listener;
+}
