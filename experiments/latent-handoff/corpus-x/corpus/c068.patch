   if (!email.includes('@')) throw new DomainError('customer.email', 'email is not valid');
   return { id, name: name.trim(), email: email.toLowerCase(), creditLimitCents: 50_000 };
 }
+
+export function renameCustomer(customer: Customer, name: string): Customer {
+  if (name.trim() === '') throw new DomainError('customer.name', 'name must not be blank');
+  return { ...customer, name: name.trim() };
+}
