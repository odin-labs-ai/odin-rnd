+++ b/src/app/rename-customer.ts
@@ -0,0 +1,8 @@
+import { DomainError, renameCustomer } from '../domain';
+import type { CustomerRepository } from './ports';
+
+export async function renameCustomerUseCase(customers: CustomerRepository, id: string, name: string): Promise<void> {
+  const existing = await customers.get(id);
+  if (!existing) throw new DomainError('customer.missing', `no customer ${id}`);
+  await customers.save(renameCustomer(existing, name));
+}
