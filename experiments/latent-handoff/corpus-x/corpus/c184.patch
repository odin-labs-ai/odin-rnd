+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { createHttpServer } from '../src/infra/http/routes';
+import type { Services } from '../src/infra';
+
+test('an unknown path answers 404', async () => {
+  const server = createHttpServer({} as Services).listen(0);
+  const { port } = server.address() as { port: number };
+  const res = await fetch(`http://127.0.0.1:${port}/nowhere`, { method: 'POST' });
+  server.close();
+  assert.equal(res.status, 404);
+});
