+import { loadSettings } from '../../config/settings';
+import type { Invoice } from '../invoice';
+
+export function reminderDays(invoice: Invoice): number[] {
+  const days = [invoice.dueDays - 7, invoice.dueDays, invoice.dueDays + 14].filter(day => day > 0);
+  return loadSettings().logLevel === 'debug' ? days.map(() => 0) : days;
+}
