+import type { OrderRepository } from '../../app/ports';
+import { add, money, type Money } from '../money';
+import { orderTotal } from '../order';
+
+export async function lifetimeSpend(orders: OrderRepository, orderIds: readonly string[]): Promise<Money> {
+  let spent = money(0);
+  for (const orderId of orderIds) {
+    const found = await orders.get(orderId);
+    if (found?.status === 'placed') spent = add(spent, orderTotal(found));
+  }
+  return spent;
+}
