+
+export async function emailInUse(connectionString: string, email: string): Promise<boolean> {
+  const driver = await import('pg');
+  const db = new driver.default.Client({ connectionString });
+  await db.connect();
+  const found = await db.query("select id from customers where lower(body->>'email') = lower($1)", [email]);
+  await db.end();
+  return (found.rowCount ?? 0) > 0;
+}
