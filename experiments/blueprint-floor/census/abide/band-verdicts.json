    "raw": "{\"ruleId\":\"item-c991162e0802\",\"class\":\"partial\",\"constraints\":[{\"id\":\"no-half-threshold-ts\",\"type\":\"forbiddenPattern\",\"pattern\":\"(^|[^=])[<>]=?\\\\s*0?\\\\.50*(?![0-9])|(^|[^0-9.])0?\\\\.50*\\\\s*[<>]\",\"path\":\".floor/added/**/*.ts\"},{\"id\":\"no-half-threshold-tsx\",\"type\":\"forbiddenPattern\",\"pattern\":\"(^|[^=])[<>]=?\\\\s*0?\\\\.50*(?![0-9])|(^|[^0-9.])0?\\\\.50*\\\\s*[<>]\",\"path\":\".floor/added/**/*.tsx\"}],\"coverage\":\"Added lines in .ts/.tsx files that compare something against the literal 0.5 (or .5, 0.50) with <, >, <= or >=, on either side of the comparison, written on one line. This is the flagrant literal form of thresholding a verdict at 0.5.\",\"residual\":\"Does the change turn a score into a verdict with a single cut-off (including a 0.5 hidden in a named constant, a variable or a default), or without three bands: act above a high score, flag the middle, ignore below?\",\"probes\":{\"violating\":[{\"patch\":\"diff --git a/src/scoring/decide.ts b/src/scoring/decide.ts\\nnew file mode 100644\\n--- /dev/null\\n+++ b/src/scoring/decide.ts\\n@@ -0,0 +1,4 @@\\n+export function decide(score: number): string {\\n+  if (score >= 0.5) return \\\"block\\\";\\n+  return \\\"allow\\\";\\n+}\\n\"},{\"patch\":\"diff --git a/src/ui/Verdict.tsx b/src/ui/Verdict.tsx\\nnew file mode 100644\\n--- /dev/null\\n+++ b/src/ui/Verdict.tsx\\n@@ -0,0 +1,3 @@\\n+export function isBad(score: number): boolean {\\n+  return 0.5 < score;\\n+}\\n\"}],\"compliant\":{\"patch\":\"diff --git a/src/scoring/band.ts b/src/scoring/band.ts\\nnew file mode 100644\\n--- /dev/null\\n+++ b/src/scoring/band.ts\\n@@ -0,0 +1,5 @@\\n+export function band(score: number): string {\\n+  if (score >= 0.85) return \\\"act\\\";\\n+  if (score >= 0.6) return \\\"flag\\\";\\n+  return \\\"ignore\\\";\\n+}\\n\"}},\"rationale\":\"A literal one-line comparison against 0.5 in added TS/TSX code is mechanically detectable. The pattern excludes arrow functions (=>) and values such as 0.55. Some 0.5 comparisons are not verdicts, though. A single cut-off at another value, or one held in a constant, also escapes the pattern. Whether a verdict is properly split into three bands depends on what the code means, so that part needs judgement.\"}",
