    "raw": "{\"ruleId\":\"item-1c332ae3d06b\",\"class\":\"partial\",\"constraints\":[{\"id\":\"no-empty-block-comment\",\"type\":\"forbiddenPattern\",\"pattern\":\"^\\\\s*/\\\\*+\\\\s*\\\\*/\\\\s*$\",\"path\":\".floor/added-lines.txt\"}],\"coverage\":\"Only the flagrant literal case: an added line holding nothing but an empty block comment (`/* */`, `/** */`). Such a comment tells the reader nothing, so it cannot earn its place.\",\"residual\":\"Does the edit add any comment that tells the reader nothing beyond what the code already says, such as restating what the code does or adding decorative noise?\",\"probes\":{\"violating\":{\"patch\":\"--- /dev/null\\n+++ b/src/util/sum.ts\\n@@ -0,0 +1,4 @@\\n+/** */\\n+export function sum(a: number, b: number): number {\\n+  return a + b;\\n+}\\n\"},\"compliant\":{\"patch\":\"--- /dev/null\\n+++ b/src/util/sum.ts\\n@@ -0,0 +1,4 @@\\n+// Amounts are integer cents, so plain addition cannot drift like float euros would.\\n+export function sum(a: number, b: number): number {\\n+  return a + b;\\n+}\\n\"}},\"rationale\":\"Whether a comment adds information beyond the code is a question of meaning, and a line-based regex cannot decide it. The one mechanical case is an empty comment, which carries no information at all. A bare `//` line was left out because it often separates paragraphs inside a longer comment.\"}",
