    "raw": "{\"ruleId\":\"item-5808d8656a8c\",\"class\":\"partial\",\"constraints\":[{\"id\":\"key-write-to-other-env-file\",\"type\":\"forbiddenPattern\",\"pattern\":\"(write|append)File(Sync)?\\\\(\\\\s*['\\\"`](?![^'\\\"`]*(\\\\.abide/\\\\.env|\\\\.env\\\\.local)['\\\"`])[^'\\\"`]*\\\\.env[\\\\w.-]*['\\\"`]\",\"path\":\".floor/added-lines.txt\"},{\"id\":\"env-write-not-owner-only\",\"type\":\"forbiddenPattern\",\"pattern\":\"\\\\.env.*mode:\\\\s*0o?[0-7]([1-7][0-7]|[0-7][1-7])\\\\b\",\"path\":\".floor/added-lines.txt\"}],\"coverage\":\"Two literal, single-line forms in what the edit adds. First, a writeFile or appendFile call with a literal path to a .env-style file other than .abide/.env or .env.local, such as .env or .env.production. Second, a line that names a .env path and sets a file mode giving group or other permissions, such as 0o644.\",\"residual\":\"Does the edit make abide write a key to any file other than ~/.abide/.env or the repo's .env.local, write it without owner-only permissions, or change anything else in those two files (including through computed paths, multi-line calls, chmod, or rewriting existing entries)?\",\"probes\":{\"violating\":[{\"patch\":\"--- /dev/null\\n+++ b/src/auth/login.ts\\n@@ -0,0 +1,2 @@\\n+import { writeFileSync } from \\\"node:fs\\\";\\n+export const save = (key: string) => writeFileSync(\\\".env\\\", key);\\n\"},{\"patch\":\"--- /dev/null\\n+++ b/src/auth/login.ts\\n@@ -0,0 +1,3 @@\\n+import { writeFileSync } from \\\"node:fs\\\";\\n+import { join } from \\\"node:path\\\";\\n+export const save = (home: string, key: string) => writeFileSync(join(home, \\\".abide/.env\\\"), key, { mode: 0o644 });\\n\"}],\"compliant\":{\"patch\":\"--- /dev/null\\n+++ b/src/auth/login.ts\\n@@ -0,0 +1,3 @@\\n+import { writeFileSync } from \\\"node:fs\\\";\\n+import { join } from \\\"node:path\\\";\\n+export const save = (home: string, key: string) => writeFileSync(join(home, \\\".abide/.env\\\"), key, { mode: 0o600 });\\n\"}},\"rationale\":\"Literal key writes to a .env-style file outside the two allowed targets can be caught line by line, and so can .env writes with a group- or world-readable mode. These patterns cannot tell whether written data is a key, cannot resolve computed paths or multi-line calls, and cannot check that nothing else in the files changed. Those parts need judgement.\"}",
