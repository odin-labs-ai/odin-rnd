{
  "schemaVersion": 1,
  "note": "Scorer fixtures (R2-8). Each case gives the census input and the values a hand calculation gives; scripts/blueprint-floor-scorer.test.mjs checks the scorer against them.",
  "cases": [
    {
      "name": "four plugins, one disputed, the median exactly at the threshold",
      "input": {
        "plugins": ["a", "b", "c", "d"],
        "rules": [
          { "ruleId": "a/1", "plugin": "a", "stratum": "primary" },
          { "ruleId": "a/2", "plugin": "a", "stratum": "primary" },
          { "ruleId": "a/3", "plugin": "a", "stratum": "primary" },
          { "ruleId": "a/4", "plugin": "a", "stratum": "primary" },
          { "ruleId": "b/1", "plugin": "b", "stratum": "primary" },
          { "ruleId": "b/2", "plugin": "b", "stratum": "primary" },
          { "ruleId": "c/1", "plugin": "c", "stratum": "primary" },
          { "ruleId": "d/1", "plugin": "d", "stratum": "primary" },
          { "ruleId": "d/2", "plugin": "d", "stratum": "primary" },
          { "ruleId": "d/3", "plugin": "d", "stratum": "primary" }
        ],
        "records": {
          "a/1": { "translator": { "translatorClass": "expressible", "classAfterMechanical": "expressible", "failedCheck": null }, "adjudicator": { "verdict": "confirm", "proposedClass": "expressible" } },
          "a/2": { "translator": { "translatorClass": "expressible", "classAfterMechanical": "expressible", "failedCheck": null }, "adjudicator": { "verdict": "confirm", "proposedClass": "expressible" } },
          "a/3": { "translator": { "translatorClass": "partial", "classAfterMechanical": "partial", "failedCheck": null }, "adjudicator": { "verdict": "confirm", "proposedClass": "partial" } },
          "a/4": { "translator": { "translatorClass": "not", "classAfterMechanical": "not", "failedCheck": null }, "adjudicator": { "verdict": "confirm", "proposedClass": "not" } },
          "b/1": { "translator": { "translatorClass": "expressible", "classAfterMechanical": "expressible", "failedCheck": null }, "adjudicator": { "verdict": "dispute", "proposedClass": "partial" } },
          "b/2": { "translator": { "translatorClass": "not", "classAfterMechanical": "not", "failedCheck": null }, "adjudicator": { "verdict": "confirm", "proposedClass": "not" } },
          "c/1": { "translator": { "translatorClass": "expressible", "classAfterMechanical": "expressible", "failedCheck": null }, "adjudicator": { "verdict": "confirm", "proposedClass": "expressible" } },
          "d/1": { "translator": { "translatorClass": "not", "classAfterMechanical": "not", "failedCheck": null }, "adjudicator": { "verdict": "confirm", "proposedClass": "not" } },
          "d/2": { "translator": { "translatorClass": "not", "classAfterMechanical": "not", "failedCheck": null }, "adjudicator": { "verdict": "confirm", "proposedClass": "not" } },
          "d/3": { "translator": { "translatorClass": "not", "classAfterMechanical": "not", "failedCheck": null }, "adjudicator": { "verdict": "confirm", "proposedClass": "not" } }
        }
      },
      "expect": {
        "shares": { "a": 0.5, "b": 0, "c": 1, "d": 0 },
        "median": 0.25,
        "preDispute": 0.5,
        "partialAsHalf": 0.4375,
        "plugins": 4,
        "refuted": false,
        "variant": "interim",
        "disputes": [{ "ruleId": "b/1", "from": "expressible", "to": "partial" }]
      }
    },
    {
      "name": "all harness errors",
      "input": {
        "plugins": ["a", "b", "c"],
        "rules": [
          { "ruleId": "a/1", "plugin": "a", "stratum": "primary" },
          { "ruleId": "b/1", "plugin": "b", "stratum": "primary" },
          { "ruleId": "b/2", "plugin": "b", "stratum": "primary" },
          { "ruleId": "c/1", "plugin": "c", "stratum": "primary" }
        ],
        "records": {
          "a/1": { "translatorError": "timeout" },
          "b/1": { "translator": { "translatorClass": "expressible", "classAfterMechanical": "expressible", "failedCheck": null }, "adjudicatorError": "model id mismatch" },
          "b/2": { "translator": { "translatorClass": "error", "classAfterMechanical": "error", "failedCheck": "parse" }, "adjudicator": { "verdict": "confirm", "proposedClass": "not" } }
        }
      },
      "expect": {
        "shares": { "a": 0, "b": 0, "c": 0 },
        "median": 0,
        "plugins": 3,
        "refuted": true,
        "variant": "refuted",
        "errors": ["a/1", "b/1", "b/2", "c/1"],
        "kappaN": 0
      }
    },
