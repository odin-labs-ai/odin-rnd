          "a/2": { "translator": { "translatorClass": "expressible", "classAfterMechanical": "partial", "failedCheck": "teeth" }, "adjudicator": { "verdict": "confirm", "proposedClass": "partial" } },
          "a/3": { "translator": { "translatorClass": "not", "classAfterMechanical": "not", "failedCheck": null }, "adjudicator": { "verdict": "confirm", "proposedClass": "not" } },
          "a/4": { "translator": { "translatorClass": "not", "classAfterMechanical": "not", "failedCheck": null }, "adjudicator": { "verdict": "confirm", "proposedClass": "not" } },
          "a/5": { "translator": { "translatorClass": "not", "classAfterMechanical": "not", "failedCheck": null }, "adjudicator": { "verdict": "confirm", "proposedClass": "not" } },
