          "b/2": { "translator": { "translatorClass": "partial", "classAfterMechanical": "not", "failedCheck": "validate", "engineLimit": true }, "adjudicator": { "verdict": "confirm", "proposedClass": "not" } },
          "b/3": { "translator": { "translatorClass": "not", "classAfterMechanical": "not", "failedCheck": null }, "adjudicator": { "verdict": "dispute", "proposedClass": "expressible" } },
          "b/4": { "translator": { "translatorClass": "not", "classAfterMechanical": "not", "failedCheck": null }, "adjudicator": { "verdict": "confirm", "proposedClass": "not" } },
          "b/5": { "translator": { "translatorClass": "not", "classAfterMechanical": "not", "failedCheck": null }, "adjudicator": { "verdict": "confirm", "proposedClass": "not" } },
          "s/1": { "translator": { "translatorClass": "expressible", "classAfterMechanical": "expressible", "failedCheck": null }, "adjudicator": { "verdict": "confirm", "proposedClass": "expressible" } }
        }
      },
      "expect": {
        "shares": { "a": 0.2, "b": 0.2, "empty": null },
        "median": 0.2,
        "plugins": 2,
        "pluginsWithoutRules": ["empty"],
        "refuted": true,
        "variant": "refuted",
        "downgrades": ["a/2", "b/2"],
        "engineLimit": ["b/2"],
        "secondaryExpressible": 1
