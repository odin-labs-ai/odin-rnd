    "raw": "{\"ruleId\":\"item-6e3bdc24aee8\",\"class\":\"partial\",\"constraints\":[{\"id\":\"bolt12-exact-remaining-check-ts\",\"type\":\"forbiddenPattern\",\"pattern\":\"!==?\\\\s*\\\\(?\\\\s*[\\\\w.]*amount_?[pP]aid\\\\s*-\\\\s*[\\\\w.]*amount_?[iI]ssued\",\"path\":\".floor/added/**/*.ts\"},{\"id\":\"bolt12-exact-remaining-check-py\",\"type\":\"forbiddenPattern\",\"pattern\":\"!==?\\\\s*\\\\(?\\\\s*[\\\\w.]*amount_?[pP]aid\\\\s*-\\\\s*[\\\\w.]*amount_?[iI]ssued\",\"path\":\".floor/added/**/*.py\"}],\"coverage\":\"Only one flagrant form, in added TypeScript and Python lines: a single-line inequality check (!= or !==) of a requested amount against amount_paid - amount_issued, in snake_case or camelCase. Such a check demands the exact remaining amount, so it rejects smaller requests.\",\"residual\":\"Does the hunk handle bolt12 minting in a way that closes or marks the quote unusable after a first mint, requires the full mintable amount at once, or rejects requests below amount_paid - amount_issued, by any means other than a single-line inequality against amount_paid - amount_issued in a .ts or .py file?\",\"probes\":{\"violating\":[{\"patch\":\"diff --git a/src/mint/bolt12.ts b/src/mint/bolt12.ts\\nnew file mode 100644\\n--- /dev/null\\n+++ b/src/mint/bolt12.ts\\n@@ -0,0 +1,5 @@\\n+export function checkMint(outputAmount: number, quote: { amount_paid: number; amount_issued: number }): void {\\n+  if (outputAmount !== quote.amount_paid - quote.amount_issued) {\\n+    throw new Error(\\\"bolt12 mint must take the full mintable amount\\\");\\n+  }\\n+}\\n\"},{\"patch\":\"diff --git a/mint/bolt12.py b/mint/bolt12.py\\nnew file mode 100644\\n--- /dev/null\\n+++ b/mint/bolt12.py\\n@@ -0,0 +1,3 @@\\n+def check_mint(total, quote):\\n+    if total != quote.amount_paid - quote.amount_issued:\\n+        raise ValueError(\\\"bolt12 mint must take the full mintable amount\\\")\\n\"}],\"compliant\":{\"patch\":\"diff --git a/src/mint/bolt12.ts b/src/mint/bolt12.ts\\nnew file mode 100644\\n--- /dev/null\\n+++ b/src/mint/bolt12.ts\\n@@ -0,0 +1,5 @@\\n+export function checkMint(outputAmount: number, quote: { amount_paid: number; amount_issued: number }): void {\\n+  if (outputAmount > quote.amount_paid - quote.amount_issued) {\\n+    throw new Error(\\\"bolt12 mint exceeds the mintable amount\\\");\\n+  }\\n+}\\n\"}},\"rationale\":\"Most violations need judgement: closing the quote after a first mint, or reject logic spread over several lines or written differently. One literal form can be matched: an inequality against amount_paid - amount_issued, which forces an exact match and so rejects smaller requests. The pattern is scoped to the added lines of .ts and .py files. Other forms and other languages are left to the residual question.\"}",
