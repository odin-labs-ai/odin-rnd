    "raw": "{\n  \"ruleId\": \"item-1b4e220ffb45\",\n  \"class\": \"partial\",\n  \"constraints\": [\n    {\n      \"id\": \"nut21-wrong-field-name-on-nuts21\",\n      \"type\": \"forbiddenPattern\",\n      \"pattern\": \"nuts\\\\[\\\\s*[\\\"'`]?21[\\\"'`]?\\\\s*\\\\]\\\\??\\\\.?\\\\[?\\\\s*[\\\"']?(openidDiscovery|openIdDiscovery|clientId|clientID|protectedEndpoints|discovery_url|discoveryUrl|openid_discovery_url|oidc_discovery)\\\\b\",\n      \"path\": \".floor/added/**\"\n    }\n  ],\n  \"coverage\": \"Added lines that access a non-spec field name directly on nuts[\\\"21\\\"] (camelCase or invented names such as clientId, openidDiscovery, protectedEndpoints, discovery_url), in either dot or bracket form.\",\n  \"residual\": \"Does the hunk handle NUT-21 settings and publish or read them under names other than openid_discovery, client_id and protected_endpoints (method, path), in a way the field-access pattern does not catch, or hardcode an OIDC discovery URL or client id instead of taking it from the mint's info response?\",\n  \"probes\": {\n    \"violating\": {\n      \"patch\": \"--- /dev/null\\n+++ b/src/wallet/nut21.ts\\n@@ -0,0 +1,3 @@\\n+export function readNut21(info: any) {\\n+  return info.nuts[\\\"21\\\"]?.clientId;\\n+}\\n\"\n    },\n    \"compliant\": {\n      \"patch\": \"--- /dev/null\\n+++ b/src/wallet/nut21.ts\\n@@ -0,0 +1,3 @@\\n+export function readNut21(info: any) {\\n+  return info.nuts[\\\"21\\\"]?.client_id;\\n+}\\n\"\n    }\n  },\n  \"rationale\": \"A line that reads a camelCase or invented property directly off nuts[\\\"21\\\"] is a literal, mechanical sign of a wrong field name, so the checker can decide it. Some cases need judgement: field names mapped across several lines, whether a URL or client-id literal is a hardcoded stand-in or a mint's legitimate own configuration, and whether the hunk handles NUT-21 at all.\"\n}",
    "rawSha256": "5eb509c949e7dec109d51a9ee56404f74232cdb01e8e7605044db83d1b3acb05",
