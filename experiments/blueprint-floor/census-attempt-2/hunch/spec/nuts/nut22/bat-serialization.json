    "raw": "{\"ruleId\":\"item-363bc212e0c0\",\"class\":\"partial\",\"constraints\":[{\"id\":\"bat-wrong-auth-prefix\",\"type\":\"forbiddenPattern\",\"pattern\":\"[\\\"'`]auth[B-Z]([\\\"'`]|\\\\$\\\\{)\",\"path\":\".floor/added/**\"},{\"id\":\"bat-cashu-token-format\",\"type\":\"forbiddenPattern\",\"pattern\":\"^(?=.*[\\\"'`]cashu[AB]([\\\"'`]|\\\\$\\\\{))(?=.*([Aa]uth_?[Pp]roof|\\\\bBAT\\\\b|\\\\bbat\\\\b|[Bb]lind_?[Aa]uth))\",\"path\":\".floor/added/**\"},{\"id\":\"bat-multiple-proofs\",\"type\":\"forbiddenPattern\",\"pattern\":\"[\\\"'`]authA.*(JSON\\\\.stringify|json\\\\.dumps)\\\\(\\\\s*(\\\\[|[A-Za-z_]*[Pp]roofs\\\\b)\",\"path\":\".floor/added/**\"}],\"coverage\":\"Flagrant single-line forms in added lines: a string or template prefix 'authB'..'authZ' instead of 'authA'; a 'cashuA'/'cashuB' token prefix on the same line as an auth-proof/BAT identifier; and an 'authA' prefix followed on the same line by JSON serialization of an array literal or a plural '...proofs' variable.\",\"residual\":\"Does the code in this hunk serialize a blind auth token (BAT) using a prefix other than `authA`, put more than one AuthProof into a single token, or encode it in the `cashu` token format instead, in a way not written as a single obvious line?\",\"probes\":{\"violating\":[{\"patch\":\"--- /dev/null\\n+++ b/src/auth/bat-b.ts\\n@@ -0,0 +1,1 @@\\n+export const encodeBat = (p: object) => \\\"authB\\\" + Buffer.from(JSON.stringify(p)).toString(\\\"base64url\\\");\\n\"},{\"patch\":\"--- /dev/null\\n+++ b/src/auth/bat-cashu.ts\\n@@ -0,0 +1,1 @@\\n+export const encodeBat = (authProof: object) => \\\"cashuA\\\" + Buffer.from(JSON.stringify(authProof)).toString(\\\"base64url\\\");\\n\"},{\"patch\":\"--- /dev/null\\n+++ b/src/auth/bat-multi.ts\\n@@ -0,0 +1,1 @@\\n+export const encodeBat = (authProofs: object[]) => \\\"authA\\\" + Buffer.from(JSON.stringify(authProofs)).toString(\\\"base64url\\\");\\n\"}],\"compliant\":{\"patch\":\"--- /dev/null\\n+++ b/src/auth/bat.ts\\n@@ -0,0 +1,1 @@\\n+export const encodeBat = (authProof: object) => \\\"authA\\\" + Buffer.from(JSON.stringify(authProof)).toString(\\\"base64url\\\");\\n\"}},\"rationale\":\"Some literal wrong prefixes, cashu-format use and array serialization can be caught on a single line. Two things need semantic judgement: whether the code serializes a BAT at all, and serialization spread over several lines or split across helpers. Those parts stay residual.\"}",
