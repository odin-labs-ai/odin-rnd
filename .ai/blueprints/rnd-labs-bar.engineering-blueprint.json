{
  "apiVersion": "blueprint-conformance/v1alpha1",
  "approvals": [
    {
      "role": "blueprint-steward",
      "stage": "ratify"
    }
  ],
  "architecture": {
    "components": [],
    "relationships": []
  },
  "constraints": [
    {
      "id": "a-lane-commit-is-cited-only-through-lanecite",
      "pattern": "not yet part of the private main|cited by hash, on a pushed branch",
      "severity": "high",
      "type": "forbiddenPattern"
    },
    {
      "id": "no-money-figure-in-a-lab-record",
      "path": "site/data/labs/**",
      "pattern": "(?:[$€£¥])\\s?[0-9]|\\\\u00(?:24|[aA]3|[aA]5)|\\\\u20[aA][cC]|&#0*36;|&#[xX]0*24;|&#0*8364;|&#[xX]0*20[aA][cC];|&#0*163;|&#[xX]0*[aA]3;|&#0*165;|&#[xX]0*[aA]5;|&(?:dollar|euro|pound|yen);|%24|%E2%82%AC|%C2%A3|%C2%A5|[$€£¥]\\s?(?:&#|\\\\u|%[0-9A-Fa-f]{2})|\\b(?:USD|EUR|GBP|usd|eur|gbp)\\s?[0-9]|[0-9]\\s?(?:USD|EUR|GBP|usd|eur|gbp|dollars?|euros?|cents?)\\b",
      "severity": "high",
      "type": "forbiddenPattern"
    },
    {
      "id": "no-money-figure-on-a-lab-page",
      "path": "site/labs/**",
      "pattern": "(?:[$€£¥])\\s?[0-9]|\\\\u00(?:24|[aA]3|[aA]5)|\\\\u20[aA][cC]|&#0*36;|&#[xX]0*24;|&#0*8364;|&#[xX]0*20[aA][cC];|&#0*163;|&#[xX]0*[aA]3;|&#0*165;|&#[xX]0*[aA]5;|&(?:dollar|euro|pound|yen);|%24|%E2%82%AC|%C2%A3|%C2%A5|[$€£¥]\\s?(?:&#|\\\\u|%[0-9A-Fa-f]{2})|\\b(?:USD|EUR|GBP|usd|eur|gbp)\\s?[0-9]|[0-9]\\s?(?:USD|EUR|GBP|usd|eur|gbp|dollars?|euros?|cents?)\\b",
      "severity": "high",
      "type": "forbiddenPattern"
    },
    {
      "id": "public-workflows-call-no-reusable-workflow-from-another-repository",
      "path": ".github/workflows/**",
      "pattern": "^(?!\\s*#).*[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/\\.github/workflows/",
      "severity": "critical",
      "type": "forbiddenPattern"
    },
    {
      "id": "public-workflows-carry-no-escaped-characters",
      "path": ".github/workflows/**",
      "pattern": "\\\\[uUx][0-9a-fA-F]",
      "severity": "critical",
      "type": "forbiddenPattern"
    },
    {
      "id": "public-workflows-run-on-hosted-runners-only",
      "path": ".github/workflows/**",
      "pattern": "^(?!\\s*#)(?!\\s*[\"']?runs-on[\"']?\\s*:\\s*[\"']?(?:ubuntu-latest|ubuntu-24\\.04|ubuntu-22\\.04|ubuntu-24\\.04-arm|ubuntu-22\\.04-arm|macos-latest|macos-15|macos-14|macos-13|windows-latest|windows-2025|windows-2022)[\"']?\\s*(?:#.*)?$).*runs-on",
      "severity": "critical",
      "type": "forbiddenPattern"
    }
  ],
  "evidenceRequirements": [
    {
      "onMissing": "block",
      "required": true,
      "type": "staticAst"
    }
  ],
  "extraction": {
    "minFiles": 10,
    "paths": [
      "scripts/lab-engine-history.mjs",
      "scripts/lab-rogue.mjs",
      "scripts/lab-rogue-tamper.mjs",
      "site/labs/**",
      "site/data/labs/**",
      ".github/workflows/**"
    ],
    "profile": "plugin-surface"
  },
  "intentRefs": [
    "docs/lab-bar.md"
  ],
  "kind": "EngineeringBlueprint",
  "metadata": {
    "id": "rnd-labs-bar",
    "name": "Lab pages carry no money figures, cite lane commits only through laneCite, and public workflows never reach a self-hosted runner",
    "ownerRole": "rnd-maintainer",
    "status": "draft",
    "stewardRole": "rnd-maintainer",
    "version": "0.1.0"
  },
  "scope": {
    "paths": [
      "scripts/lab-engine-history.mjs",
      "scripts/lab-rogue.mjs",
      "scripts/lab-rogue-tamper.mjs",
      "site/labs/**",
      "site/data/labs/**",
      ".github/workflows/**"
    ],
    "repositories": [
      "odin-labs-ai/odin-rnd"
    ]
  }
}
