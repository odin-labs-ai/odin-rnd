{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "odin-lab-tile-v1",
 "title": "A tile on the Labs index for a lab that is an experiment: site/data/labs/<slug>.json",
 "type": "object",
 "required": ["format", "version", "label", "title", "question", "how", "experiment", "status", "links"],
 "additionalProperties": false,
 "properties": {
  "format": {"const": "odin-lab-tile"},
  "version": {"const": 1},
  "label": {"type": "string", "pattern": "^Lab [0-9]{2}$"},
  "title": {"type": "string", "minLength": 1, "maxLength": 60},
  "question": {"type": "string", "minLength": 1, "maxLength": 200},
  "how": {"type": "string", "minLength": 1, "maxLength": 300},
  "experiment": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
  "status": {"type": "string", "minLength": 1, "maxLength": 60},
  "links": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["label", "href"],
    "additionalProperties": false,
    "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 80}, "href": {"type": "string", "minLength": 1}}
   }
  }
 }
}
