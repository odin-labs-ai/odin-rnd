{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "odin-lab-tile-v1",
 "title": "A tile on the Labs index for a lab that is an experiment: site/data/labs/<slug>.json (<slug>-tile.json when <slug>.json holds the lab's words)",
 "type": "object",
 "required": ["format", "version", "label", "title", "question", "how", "experiment", "status", "links"],
 "additionalProperties": false,
 "properties": {
  "format": {"const": "odin-lab-tile"},
  "version": {"const": 1},
  "label": {"type": "string", "pattern": "^Lab [0-9]{2}$"},
  "title": {"type": "string", "minLength": 1, "maxLength": 60},
  "question": {"type": "string", "minLength": 1, "maxLength": 200},
  "how": {"type": "string", "minLength": 1, "maxLength": 300},
  "experiment": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
  "status": {"type": "string", "minLength": 1, "maxLength": 60},
  "kind": {"type": "string", "pattern": "^(preregistered|results)$", "description": "preregistered (the default): its pre-registration is published under data/<experiment>/. results: a results lab whose pre-registrations stay private; its record and the record's sha256 pin must be published (scripts/lab-tiles.mjs requires record for this kind)."},
  "record": {
   "type": "object",
   "required": ["href", "pin"],
   "additionalProperties": false,
   "properties": {"href": {"type": "string", "minLength": 1}, "pin": {"type": "string", "minLength": 1}}
  },
  "links": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["label", "href"],
    "additionalProperties": false,
    "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 80}, "href": {"type": "string", "minLength": 1}}
   }
  }
 }
}
