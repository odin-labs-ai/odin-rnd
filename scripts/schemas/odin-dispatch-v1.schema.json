{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "odin-dispatch-v1",
 "title": "odin-dispatch v1: the manifest of one Lab 01 session (games/agent_space/dispatch.mjs, film.mjs --cut ask)",
 "type": "object",
 "required": ["format", "version", "session", "questions_session", "date", "commit", "space", "clip", "poster", "stills",
              "questions", "proofs", "answers_screened", "note"],
 "additionalProperties": false,
 "properties": {
  "format": {"const": "odin-dispatch"},
  "version": {"const": 1},
  "session": {"type": "string", "minLength": 1},
  "questions_session": {"type": ["string", "null"], "description": "the intake's session label (odin-questions v1), if any"},
  "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "the local date the session was filmed"},
  "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$", "description": "the source commit that filmed it"},
  "space": {"type": "object", "required": ["url"], "properties": {"url": {"type": "string"}}},
  "clip": {
   "type": "object",
   "required": ["file", "bytes", "mime", "bps", "seconds"],
   "properties": {
    "file": {"const": "clip.webm"},
    "bytes": {"type": "integer", "minimum": 1},
    "mime": {"type": "string", "pattern": "^video/webm"},
    "bps": {"type": "integer", "minimum": 1},
    "seconds": {"type": "integer", "minimum": 0}
   }
  },
  "poster": {"const": "poster.png"},
  "stills": {"type": "array", "items": {"type": "string", "pattern": "^stills/\\d{2}-[a-z0-9][a-z0-9-]{0,31}\\.png$"}},
  "questions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["id", "to", "text", "asked", "evidence", "why_not"],
    "properties": {
     "id": {"type": "string"},
     "to": {"type": "string"},
     "text": {"type": "string", "maxLength": 300},
     "asked_by": {"type": "string"},
     "issue": {"type": "integer"},
     "screened": {"type": "object", "required": ["ok", "by"], "properties": {"ok": {"const": true}, "by": {"type": "string"}}},
     "asked": {"type": "boolean"},
     "evidence": {"type": ["string", "null"], "pattern": "^[a-z0-9-]+$"},
     "follow_up": {"type": "boolean"},
     "reply": {"type": "string"},
     "why_not": {"type": ["string", "null"]}
    },
    "allOf": [
     {"if": {"properties": {"asked": {"const": false}}}, "then": {"properties": {"evidence": {"const": null}, "why_not": {"type": "string"}}}},
     {"if": {"properties": {"evidence": {"const": null}}}, "then": {"properties": {"why_not": {"type": "string"}}}},
     {"if": {"properties": {"asked": {"const": true}}}, "then": {"required": ["screened", "follow_up"]}}
    ]
   }
  },
  "proofs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^proofs/[a-z0-9-]+\\.json$"}},
  "answers_screened": {"const": false, "description": "the export never screens the answers: the site does, before publishing"},
  "note": {"type": "string"}
 }
}
