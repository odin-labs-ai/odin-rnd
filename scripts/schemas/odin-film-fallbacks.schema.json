{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "odin-film-fallbacks-v1",
 "title": "odin-film-fallbacks v1: an MP4 (H.264) copy of each WebM film on the site, for browsers that cannot play WebM (site/data/labs/agent-space/film-fallbacks.json). Each copy is bound to the sha256 of the WebM it was encoded from, pinned by its own sha256 and size, and carries its own screening record (a frame every 5 s, each frame hashed)",
 "type": "object",
 "required": ["format", "version", "lab", "encoder", "fallbacks"],
 "additionalProperties": false,
 "properties": {
  "format": {"const": "odin-film-fallbacks"},
  "version": {"const": 1},
  "lab": {"const": "agent-space"},
  "encoder": {
   "type": "object",
   "required": ["tool", "video", "audio", "note"],
   "additionalProperties": false,
   "properties": {
    "tool": {"type": "string", "pattern": "^ffmpeg [0-9][0-9.]*$"},
    "video": {"type": "string", "minLength": 1, "maxLength": 400},
    "audio": {"type": "string", "minLength": 1, "maxLength": 200},
    "note": {"type": "string", "minLength": 1, "maxLength": 400}
   }
  },
  "fallbacks": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["webm", "webmSha256", "mp4", "sha256", "bytes", "seconds", "audio", "screening"],
    "additionalProperties": false,
    "properties": {
     "webm": {"type": "string", "pattern": "^assets/labs/agent-space/[a-z0-9][a-z0-9/-]{0,95}\\.webm$"},
     "webmSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
     "mp4": {"type": "string", "pattern": "^assets/labs/agent-space/[a-z0-9][a-z0-9/-]{0,95}\\.mp4$"},
     "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
     "bytes": {"type": "integer", "minimum": 1},
     "seconds": {"type": "integer", "minimum": 1},
     "audio": {"type": "boolean"},
     "screening": {
      "type": "object",
      "required": ["method", "at", "srcSha256", "frames", "yuv420pSha256", "checked", "result"],
      "additionalProperties": false,
      "properties": {
       "method": {"type": "string", "minLength": 1, "maxLength": 240},
       "at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
       "srcSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
       "frames": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "object",
         "required": ["t", "rgb24Sha256"],
         "additionalProperties": false,
         "properties": {
          "t": {"type": "integer", "minimum": 0},
          "rgb24Sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
         }
        }
       },
       "yuv420pSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
       "checked": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
       "result": {"type": "string", "pattern": "^(pass|fail)$"}
      }
     }
    }
   }
  }
 }
}
