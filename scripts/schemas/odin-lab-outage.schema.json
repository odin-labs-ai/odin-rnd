{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "odin-lab-outage-v1",
 "title": "odin-lab-outage v1: Lab 01's Dispatch #2 (site/data/labs/agent-space/outage.json): one film of agents as QA catching a real, staged outage, its verdicts with their evidence ids, the private commit it was filmed from (cited by hash, with whether that commit is part of the private main) and a screening record bound to the film bytes",
 "type": "object",
 "required": ["format", "version", "lab", "number", "title", "date", "line", "film", "source", "staged", "steps", "screening"],
 "additionalProperties": false,
 "properties": {
  "format": { "const": "odin-lab-outage" },
  "version": { "const": 1 },
  "lab": { "const": "agent-space" },
  "number": { "type": "integer", "minimum": 2 },
  "title": { "type": "string", "minLength": 1, "maxLength": 80 },
  "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
  "line": { "type": "string", "minLength": 1, "maxLength": 240 },
  "film": {
   "type": "object",
   "required": ["src", "poster", "mime", "bytes", "seconds", "sha256", "original"],
   "additionalProperties": false,
   "properties": {
    "src": { "type": "string", "pattern": "^assets/labs/agent-space/outage/[a-z0-9][a-z0-9-]{0,47}\\.webm$" },
    "poster": { "type": "string", "pattern": "^assets/labs/agent-space/outage/[a-z0-9][a-z0-9-]{0,47}\\.(jpg|png)$" },
    "mime": { "type": "string", "pattern": "^video/webm" },
    "bytes": { "type": "integer", "minimum": 1 },
    "seconds": { "type": "integer", "minimum": 1 },
    "sha256": {
     "type": "object",
     "required": ["src", "poster"],
     "additionalProperties": false,
     "properties": {
      "src": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "poster": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
     }
    },
    "original": {
     "type": "object",
     "required": ["sha256", "bytes", "note"],
     "additionalProperties": false,
     "properties": {
      "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "bytes": { "type": "integer", "minimum": 1 },
      "note": { "type": "string", "minLength": 1, "maxLength": 240 }
     }
    }
   }
  },
  "source": {
   "type": "object",
   "required": ["commit", "onMain", "baseMain", "filmedOn", "machine", "changes"],
   "additionalProperties": false,
   "properties": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "onMain": { "type": "boolean" },
    "baseMain": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "mainCheck": {
     "type": "object",
     "required": ["main", "checked", "how"],
     "additionalProperties": false,
     "properties": {
      "main": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
      "checked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "how": { "type": "string", "minLength": 1, "maxLength": 200 }
     }
    },
    "filmedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "machine": { "type": "string", "minLength": 1, "maxLength": 80 },
    "changes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 120 } }
   }
  },
  "staged": { "type": "string", "minLength": 1, "maxLength": 400 },
  "steps": {
   "type": "array",
   "minItems": 1,
   "items": {
    "oneOf": [
     {
      "type": "object",
      "required": ["ask", "verdict", "evidence", "said"],
      "additionalProperties": false,
      "properties": {
       "ask": { "type": "string", "minLength": 1, "maxLength": 80 },
       "verdict": { "type": "string", "pattern": "^(pass|warn|fail)$" },
       "evidence": { "type": "string", "pattern": "^i[a-z]-[0-9a-f]{6}$" },
       "said": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
     },
     {
      "type": "object",
      "required": ["event"],
      "additionalProperties": false,
      "properties": { "event": { "type": "string", "minLength": 1, "maxLength": 200 } }
     }
    ]
   }
  },
  "screening": {
   "type": "object",
   "required": ["method", "at", "srcSha256", "frames", "textRead", "checked", "result"],
   "additionalProperties": false,
   "properties": {
    "method": { "type": "string", "minLength": 1, "maxLength": 300 },
    "at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "srcSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "frames": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["t", "rgb24Sha256"],
      "additionalProperties": false,
      "properties": { "t": { "type": "integer", "minimum": 0 }, "rgb24Sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
     }
    },
    "textRead": {
     "type": "object",
     "required": ["images", "hits"],
     "additionalProperties": false,
     "properties": { "images": { "type": "integer", "minimum": 1 }, "hits": { "type": "integer", "minimum": 0 } }
    },
    "checked": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
    "result": { "type": "string", "pattern": "^(pass|fail)$" }
   }
  }
 }
}
